+// Claybox: write every video's frames as PNGs, for upscaling on the user's Mac.
+// <out>/<HASH>/<NNNNN>.png, then an empty <out>/<HASH>/done when a video is complete.
+// Waits while a few finished videos are still waiting to be picked up, to keep disk use low.
+static void clayboxDumpVideos(ResourceMan *res, const Common::FSNode &out) {
+	Common::Array<uint32> hashes = res->getResourceHashes(kResTypeVideo);
+	{
+		Common::DumpFile total;
+		if (total.open(out.getChild("total.txt")))
+			total.writeString(Common::String::format("%u\n", hashes.size()));
+	}
+	for (uint i = 0; i < hashes.size(); i++) {
+		if (g_engine->shouldQuit())
+			return;
+		// throttle
+		for (;;) {
+			Common::FSList dirs;
+			out.getChildren(dirs, Common::FSNode::kListDirectoriesOnly);
+			if (dirs.size() < 3 || g_engine->shouldQuit())
+				break;
+			g_system->delayMillis(300);
+		}
+		const Common::String name = Common::String::format("%08X", hashes[i]);
+		Common::FSNode dir = out.getChild(name);
+		if (!dir.exists() && !dir.createDirectory())
+			continue;
+		Video::SmackerDecoder decoder;
+		Common::SeekableReadStream *stream = res->createStream(hashes[i]);
+		if (!stream || !decoder.loadStream(stream))
+			continue;
+		while (!decoder.endOfVideo()) {
+			const Graphics::Surface *frame = decoder.decodeNextFrame();
+			if (!frame)
+				break;
+			Common::DumpFile file;
+			if (file.open(dir.getChild(Common::String::format("%05d.png", decoder.getCurFrame()))))
+				Image::writePNG(file, *frame, decoder.getPalette(), 256);
+		}
+		Common::DumpFile done;
+		done.open(dir.getChild("done"));
+	}
+}
+
+// Claybox: write every animation frame for upscaling on the user's Mac:
+//   <out>/rgb/<ANIM>_<FFFF>.png   colors (transparent area filled with nearby colors, so edges stay clean)
+//   <out>/mask/<ANIM>_<FFFF>.png  white where the sprite is, black where it's transparent
+//   <out>/pal/<ANIM>.bin          the animation's own palette (1024 bytes)
+// Writes one sprite frame (8-bit pixels + palette) as colour PNG (transparent area grown from
+// its neighbours) and mask PNG, named <HASH>_<FFFF>.png.
+static void clayboxWriteSpriteFrame(const Graphics::Surface &index, int w, int h, const byte *pal,
+		const Common::FSNode &rgbDir, const Common::FSNode &maskDir, uint32 hash, uint frame) {
+	const Graphics::PixelFormat rgba = Graphics::PixelFormat::createFormatRGBA32();
+	Common::Array<int> r(w * h, -1), g(w * h), b(w * h);
+	for (int y = 0; y < h; y++)
+		for (int x = 0; x < w; x++) {
+			const byte c = *(const byte*)index.getBasePtr(x, y);
+			if (c) {
+				r[y * w + x] = pal[c * 4]; g[y * w + x] = pal[c * 4 + 1]; b[y * w + x] = pal[c * 4 + 2];
+			}
+		}
+	for (int pass = 0; pass < 6; pass++) {
+		Common::Array<int> nr(r), ng(g), nb(b);
+		for (int y = 0; y < h; y++)
+			for (int x = 0; x < w; x++) {
+				if (r[y * w + x] >= 0)
+					continue;
+				int sr = 0, sg = 0, sb = 0, n = 0;
+				for (int dy = -1; dy <= 1; dy++)
+					for (int dx = -1; dx <= 1; dx++) {
+						const int xx = x + dx, yy = y + dy;
+						if (xx < 0 || yy < 0 || xx >= w || yy >= h || r[yy * w + xx] < 0)
+							continue;
+						sr += r[yy * w + xx]; sg += g[yy * w + xx]; sb += b[yy * w + xx]; n++;
+					}
+				if (n) {
+					nr[y * w + x] = sr / n; ng[y * w + x] = sg / n; nb[y * w + x] = sb / n;
+				}
+			}
+		r = nr; g = ng; b = nb;
+	}
+	Graphics::Surface colors, mask;
+	colors.create(w, h, rgba);
+	mask.create(w, h, rgba);
+	for (int y = 0; y < h; y++)
+		for (int x = 0; x < w; x++) {
+			const int k = y * w + x;
+			const bool solid = *(const byte*)index.getBasePtr(x, y) != 0;
+			*(uint32*)colors.getBasePtr(x, y) = r[k] >= 0 ? rgba.RGBToColor(r[k], g[k], b[k]) : rgba.RGBToColor(0, 0, 0);
+			*(uint32*)mask.getBasePtr(x, y) = solid ? rgba.RGBToColor(255, 255, 255) : rgba.RGBToColor(0, 0, 0);
+		}
+	const Common::String frameName = Common::String::format("%08X_%04u.png", hash, frame);
+	Common::DumpFile cf, mf;
+	if (cf.open(rgbDir.getChild(frameName)))
+		Image::writePNG(cf, colors);
+	if (mf.open(maskDir.getChild(frameName)))
+		Image::writePNG(mf, mask);
+	colors.free();
+	mask.free();
+}
+
+static void clayboxWritePalette(const Common::FSNode &palDir, uint32 hash, const byte *pal) {
+	Common::DumpFile palFile;
+	if (palFile.open(palDir.getChild(Common::String::format("%08X.bin", hash))))
+		palFile.write(pal, 1024);
+}
+
+// Claybox: write every animation frame and every small (non-background) bitmap for upscaling:
+//   <out>/rgb/<HASH>_<FFFF>.png, <out>/mask/<HASH>_<FFFF>.png, <out>/pal/<HASH>.bin
+static void clayboxDumpSprites(NeverhoodEngine *vm, ResourceMan *res, const Common::FSNode &out) {
+	Common::FSNode rgbDir = out.getChild("rgb"), maskDir = out.getChild("mask"), palDir = out.getChild("pal");
+	rgbDir.createDirectory();
+	maskDir.createDirectory();
+	palDir.createDirectory();
+	uint frameTotal = 0;
+
+	// animations
+	Common::Array<uint32> hashes = res->getResourceHashes(kResTypeAnimation);
+	for (uint i = 0; i < hashes.size(); i++) {
+		if (g_engine->shouldQuit())
+			return;
+		AnimResource anim(vm);
+		if (!anim.load(hashes[i]) || !anim.getPaletteData())
+			continue;
+		clayboxWritePalette(palDir, hashes[i], anim.getPaletteData());
+		for (uint f = 0; f < anim.getFrameCount(); f++) {
+			const AnimFrameInfo &info = anim.getFrameInfo(f);
+			const int w = info.drawOffset.width, h = info.drawOffset.height;
+			if (w <= 0 || h <= 0 || w > 1024 || h > 1024)
+				continue;
+			Graphics::Surface index;
+			index.create((w + 3) & ~3, h, Graphics::PixelFormat::createFormatCLUT8());
+			index.fillRect(Common::Rect(0, 0, index.w, index.h), 0);
+			anim.draw(f, &index, false, false);
+			clayboxWriteSpriteFrame(index, w, h, anim.getPaletteData(), rgbDir, maskDir, hashes[i], f);
+			index.free();
+			frameTotal++;
+		}
+	}
+
+	// static objects: bitmaps smaller than the screen that carry their own palette
+	Common::Array<uint32> bitmaps = res->getResourceHashes(kResTypeBitmap);
+	for (uint i = 0; i < bitmaps.size(); i++) {
+		if (g_engine->shouldQuit())
+			return;
+		SpriteResource sprite(vm);
+		PaletteResource palette(vm);
+		if (!sprite.load(bitmaps[i]) || !palette.load(bitmaps[i]) || !palette.palette())
+			continue;
+		const int w = sprite.getDimensions().width, h = sprite.getDimensions().height;
+		if (w <= 0 || h <= 0 || (w >= 640 && h >= 480) || w > 1024 || h > 1024)
+			continue;
+		byte pal[1024];
+		palette.copyPalette(pal);
+		Graphics::Surface index;
+		index.create((w + 3) & ~3, h, Graphics::PixelFormat::createFormatCLUT8());
+		index.fillRect(Common::Rect(0, 0, index.w, index.h), 0);
+		sprite.draw(&index, false, false);
+		clayboxWritePalette(palDir, bitmaps[i], pal);
+		clayboxWriteSpriteFrame(index, w, h, pal, rgbDir, maskDir, bitmaps[i], 0);
+		index.free();
+		frameTotal++;
+	}
+
+	Common::DumpFile done;
+	if (done.open(out.getChild("done")))
+		done.writeString(Common::String::format("%u\n", frameTotal));
+}
 
