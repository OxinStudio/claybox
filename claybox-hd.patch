+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ *
+ */
+
+#include "common/file.h"
+#include "common/system.h"
+#include "common/str.h"
+#include "common/textconsole.h"
+#include "image/png.h"
+#include "image/jpeg.h"
+
+#include "neverhood/hdlayer.h"
+#include "neverhood/neverhood.h"
+#include "neverhood/resource.h"
+
+namespace Neverhood {
+
+HDLayer::HDLayer(NeverhoodEngine *vm, const Common::FSNode &dir, const Graphics::PixelFormat &format)
+	: _vm(vm), _dir(dir), _format(format), _useCounter(0) {
+	for (int i = 0; i < kAllSlots; i++)
+		_images[i] = nullptr;
+	_spriteDirChecked = _spriteDirOk = false;
+	for (int i = 0; i < kVideoSlots; i++)
+		_videoSlotHash[i] = 0;
+}
+
+HDLayer::~HDLayer() {
+	for (int i = 0; i < kAllSlots; i++)
+		freeImage(i);
+}
+
+bool HDLayer::folderHasImages(const Common::FSNode &dir) {
+	if (!dir.exists() || !dir.isDirectory())
+		return false;
+	Common::FSList files;
+	if (!dir.getChildren(files, Common::FSNode::kListFilesOnly))
+		return false;
+	for (Common::FSList::const_iterator it = files.begin(); it != files.end(); ++it)
+		if (it->getFileName().hasSuffixIgnoreCase(".png"))
+			return true;
+	return false;
+}
+
+void HDLayer::freeImage(int index) {
+	if (_images[index]) {
+		_images[index]->surface.free();
+		delete _images[index];
+		_images[index] = nullptr;
+	}
+}
+
+HDImage *HDLayer::loadImage(uint32 fileHash, const Graphics::Surface *surface) {
+	const Common::String name = Common::String::format("%08X.png", fileHash);
+	Common::FSNode node = _dir.getChild(name);
+	if (!node.exists())
+		return nullptr;
+
+	Common::File file;
+	if (!file.open(node))
+		return nullptr;
+
+	Image::PNGDecoder decoder;
+	if (!decoder.loadStream(file)) {
+		warning("Claybox HD: could not decode %s", name.c_str());
+		return nullptr;
+	}
+
+	const Graphics::Surface *png = decoder.getSurface();
+	// The HD image is kScale x the original sprite. The background surface may be
+	// a few pixels wider than the sprite (its pitch is aligned to 4 bytes).
+	if (png->w > surface->w * kScale || png->h > surface->h * kScale ||
+		png->w < (surface->w - 4) * kScale || png->h < surface->h * kScale) {
+		warning("Claybox HD: %s has size %dx%d, expected about %dx%d - ignored",
+			name.c_str(), png->w, png->h, surface->w * kScale, surface->h * kScale);
+		return nullptr;
+	}
+
+	HDImage *image = new HDImage();
+	image->fileHash = fileHash;
+	image->boundCount = 0;
+	image->lastUse = 0;
+	image->video = false;
+	image->sprite = false;
+	image->frame = 0;
+	image->flipX = image->flipY = false;
+	Graphics::Surface *converted = png->convertTo(_format, decoder.getPalette().data(), decoder.getPalette().size());
+	image->surface.copyFrom(*converted);
+	converted->free();
+	delete converted;
+
+	// The palette the original bitmap was drawn with, used to follow palette fades.
+	PaletteResource paletteResource(_vm);
+	if (paletteResource.load(fileHash))
+		paletteResource.copyPalette(image->basePalette);
+	else
+		memset(image->basePalette, 0, sizeof(image->basePalette));
+
+	g_system->logMessage(LogMessageType::kInfo, Common::String::format("Claybox HD: showing HD background %s\n", name.c_str()).c_str());
+	return image;
+}
+
+byte HDLayer::acquireImage(uint32 fileHash, const Graphics::Surface *surface) {
+	// Already cached?
+	for (int i = 0; i < kMaxImages; i++)
+		if (_images[i] && _images[i]->fileHash == fileHash)
+			return i + 1;
+
+	HDImage *image = loadImage(fileHash, surface);
+	if (!image)
+		return 0;
+
+	// Find a free slot, or evict the least recently used unbound image.
+	int slot = -1;
+	for (int i = 0; i < kMaxImages && slot < 0; i++)
+		if (!_images[i])
+			slot = i;
+	if (slot < 0) {
+		uint32 oldest = 0xFFFFFFFF;
+		for (int i = 0; i < kMaxImages; i++)
+			if (_images[i]->boundCount == 0 && _images[i]->lastUse < oldest) {
+				oldest = _images[i]->lastUse;
+				slot = i;
+			}
+	}
+	if (slot < 0) {
+		image->surface.free();
+		delete image;
+		return 0;
+	}
+	freeImage(slot);
+	_images[slot] = image;
+	return slot + 1;
+}
+
+void HDLayer::bindSurface(const Graphics::Surface *surface, uint32 fileHash) {
+	unbindSurface(surface);
+	if (!fileHash)
+		return;
+	byte id = acquireImage(fileHash, surface);
+	if (!id)
+		return;
+	HDImage *image = _images[id - 1];
+	image->boundCount++;
+	image->lastUse = ++_useCounter;
+	Binding binding;
+	binding.surface = surface;
+	binding.imageId = id;
+	_bindings.push_back(binding);
+}
+
+void HDLayer::unbindSurface(const Graphics::Surface *surface) {
+	for (uint i = 0; i < _bindings.size(); i++) {
+		if (_bindings[i].surface == surface) {
+			HDImage *image = getImage(_bindings[i].imageId);
+			if (image && image->boundCount > 0)
+				image->boundCount--;
+			_bindings.remove_at(i);
+			return;
+		}
+	}
+}
+
+void HDLayer::bindVideoFrame(const Graphics::Surface *surface, uint32 fileHash, uint32 frame) {
+	unbindSurface(surface);
+	if (!_videoDir.exists())
+		return;
+	Common::FSNode dir = _videoDir.getChild(Common::String::format("%08X", fileHash));
+	if (!dir.isDirectory())
+		return;
+	Common::FSNode node = dir.getChild(Common::String::format("%05u.jpg", frame));
+	Common::File file;
+	if (!node.exists() || !file.open(node))
+		return;
+	Image::JPEGDecoder decoder;
+	if (!decoder.loadStream(file))
+		return;
+	const Graphics::Surface *jpg = decoder.getSurface();
+	if (!jpg || jpg->w < surface->w * 2 - 8 || jpg->w > surface->w * 2 + 8 || jpg->h != surface->h * 2)
+		return;
+
+	// reuse the slot already showing this video, else the other one
+	int slot = 0;
+	for (int i = 0; i < kVideoSlots; i++)
+		if (_videoSlotHash[i] == fileHash)
+			slot = i;
+	if (_videoSlotHash[slot] != fileHash)
+		for (int i = 0; i < kVideoSlots; i++)
+			if (_videoSlotHash[i] == 0 || !_images[kMaxImages + i] || _images[kMaxImages + i]->boundCount == 0) {
+				slot = i;
+				break;
+			}
+	const int index = kMaxImages + slot;
+	HDImage *image = _images[index];
+	if (!image) {
+		image = new HDImage();
+		_images[index] = image;
+	}
+	image->surface.free();
+	Graphics::Surface *converted = jpg->convertTo(_format);
+	image->surface.copyFrom(*converted);
+	converted->free();
+	delete converted;
+	image->fileHash = fileHash;
+	image->video = true;
+	image->sprite = false;
+	image->boundCount = 1;
+	image->lastUse = ++_useCounter;
+	memset(image->basePalette, 0, sizeof(image->basePalette));
+	_videoSlotHash[slot] = fileHash;
+
+	Binding binding;
+	binding.surface = surface;
+	binding.imageId = index + 1;
+	_bindings.push_back(binding);
+}
+
+void HDLayer::bindSprite(const Graphics::Surface *surface, uint32 animHash, uint32 frame, bool flipX, bool flipY) {
+	unbindSurface(surface);
+	if (!_spriteDirChecked) {
+		_spriteDirChecked = true;
+		_spriteDirOk = _spriteDir.exists() && _spriteDir.isDirectory();
+	}
+	if (!_spriteDirOk || !animHash)
+		return;
+
+	// cached?
+	int slot = -1;
+	for (int i = kMaxImages + kVideoSlots; i < kAllSlots && slot < 0; i++) {
+		const HDImage *im = _images[i];
+		if (im && im->sprite && im->fileHash == animHash && im->frame == frame && im->flipX == flipX && im->flipY == flipY)
+			slot = i;
+	}
+
+	if (slot < 0) {
+		Common::FSNode dir = _spriteDir.getChild(Common::String::format("%08X", animHash));
+		Common::FSNode node = dir.getChild(Common::String::format("%04u.png", frame));
+		Common::File file;
+		if (!node.exists() || !file.open(node))
+			return;
+		Image::PNGDecoder decoder;
+		if (!decoder.loadStream(file))
+			return;
+		Graphics::Surface *conv = decoder.getSurface()->convertTo(spriteFormat(), decoder.getPalette().data(), decoder.getPalette().size());
+		if (!conv)
+			return;
+		// pick a free slot, else the least recently used unbound one
+		uint32 oldest = 0xFFFFFFFF;
+		for (int i = kMaxImages + kVideoSlots; i < kAllSlots; i++) {
+			if (!_images[i]) { slot = i; break; }
+			if (_images[i]->boundCount == 0 && _images[i]->lastUse < oldest) {
+				oldest = _images[i]->lastUse;
+				slot = i;
+			}
+		}
+		if (slot < 0) {
+			conv->free();
+			delete conv;
+			return;
+		}
+		freeImage(slot);
+		HDImage *image = new HDImage();
+		image->surface.create(conv->w, conv->h, spriteFormat());
+		for (int y = 0; y < conv->h; y++)
+			for (int x = 0; x < conv->w; x++) {
+				const int sx = flipX ? conv->w - 1 - x : x;
+				const int sy = flipY ? conv->h - 1 - y : y;
+				*(uint32*)image->surface.getBasePtr(x, y) = *(const uint32*)conv->getBasePtr(sx, sy);
+			}
+		conv->free();
+		delete conv;
+		image->fileHash = animHash;
+		image->frame = frame;
+		image->flipX = flipX;
+		image->flipY = flipY;
+		image->video = false;
+		image->sprite = true;
+		image->boundCount = 0;
+		memset(image->basePalette, 0, sizeof(image->basePalette));
+		Common::File palFile;
+		if (palFile.open(dir.getChild("palette.bin")))
+			palFile.read(image->basePalette, 1024);
+		_images[slot] = image;
+	}
+
+	HDImage *image = _images[slot];
+	image->boundCount++;
+	image->lastUse = ++_useCounter;
+	Binding binding;
+	binding.surface = surface;
+	binding.imageId = slot + 1;
+	_bindings.push_back(binding);
+}
+
+byte HDLayer::findImageId(const Graphics::Surface *surface) const {
+	for (uint i = 0; i < _bindings.size(); i++)
+		if (_bindings[i].surface == surface)
+			return _bindings[i].imageId;
+	return 0;
+}
+
+} // End of namespace Neverhood
