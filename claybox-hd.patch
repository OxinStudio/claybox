+
+// Claybox HD layer: optional 2x replacement images for backgrounds.
+//
+// The game logic keeps running at 640x480 with 8-bit indexed pixels.
+// HD images are looked up by resource hash in a user-generated folder
+// (made on the user's own machine from their own game disc; nothing is
+// shipped with the app). Everything without an HD image is scaled up
+// from the original pixels.
+
+#ifndef NEVERHOOD_HDLAYER_H
+#define NEVERHOOD_HDLAYER_H
+
+#include "common/array.h"
+#include "common/fs.h"
+#include "graphics/pixelformat.h"
+#include "graphics/surface.h"
+
+namespace Neverhood {
+
+class NeverhoodEngine;
+
+struct HDImage {
+	uint32 fileHash;
+	Graphics::Surface surface;  // kScale x the original, in the screen format
+	byte basePalette[1024];     // the palette the image was made with (RGBX)
+	uint32 lastUse;
+	int boundCount;
+	bool video;              // a video frame: colors are final, no palette following
+	bool sprite;             // an animation frame: RGBA (alpha = soft edges), stored as RGBA32
+	uint32 frame;            // sprite frame index
+	bool flipX, flipY;       // sprite stored mirrored
+};
+
+class HDLayer {
+public:
+	static const int kScale = 2;
+	static const int kMaxImages = 16;      // background slots: ids 1..16
+	static const int kVideoSlots = 2;      // video frame slots: ids 17..18
+	static const int kSpriteSlots = 100;   // animation frame slots: ids 19..118
+	static const int kAllSlots = kMaxImages + kVideoSlots + kSpriteSlots;
+	static const byte kDoubledFlag = 0x80; // owner flag: pixel belongs to a 2x-doubled video
+
+	HDLayer(NeverhoodEngine *vm, const Common::FSNode &dir, const Graphics::PixelFormat &format);
+	~HDLayer();
+
+	// Called whenever a background surface gets new pixels.
+	void bindSurface(const Graphics::Surface *surface, uint32 fileHash);
+	void unbindSurface(const Graphics::Surface *surface);
+
+	// Returns an image id (1..kMaxImages) bound to the surface, or 0.
+	byte findImageId(const Graphics::Surface *surface) const;
+	HDImage *getImage(byte id) const { return (id > 0 && id <= kAllSlots) ? _images[id - 1] : nullptr; }
+
+	// HD animation frames: <sprite folder>/<ANIM>/<FFFF>.png (RGBA, 2x) + palette.bin
+	void setSpriteDir(const Common::FSNode &dir) { _spriteDir = dir; }
+	void bindSprite(const Graphics::Surface *surface, uint32 animHash, uint32 frame, bool flipX, bool flipY);
+	static Graphics::PixelFormat spriteFormat() { return Graphics::PixelFormat::createFormatRGBA32(); }
+
+	// HD video frames: <video folder>/<HASH>/<NNNNN>.jpg, 2x the video's own size.
+	void setVideoDir(const Common::FSNode &dir) { _videoDir = dir; }
+	void bindVideoFrame(const Graphics::Surface *surface, uint32 fileHash, uint32 frame);
+
+	const Graphics::PixelFormat &getFormat() const { return _format; }
+
+	// True if the folder contains at least one HD image.
+	static bool folderHasImages(const Common::FSNode &dir);
+
+private:
+	struct Binding {
+		const Graphics::Surface *surface;
+		byte imageId;
+	};
+
+	byte acquireImage(uint32 fileHash, const Graphics::Surface *surface);
+	HDImage *loadImage(uint32 fileHash, const Graphics::Surface *surface);
+	void freeImage(int index);
+
+	NeverhoodEngine *_vm;
+	Common::FSNode _dir;
+	Graphics::PixelFormat _format;
+	HDImage *_images[kAllSlots];
+	Common::FSNode _spriteDir;
+	bool _spriteDirChecked, _spriteDirOk;
+	Common::FSNode _videoDir;
+	uint32 _videoSlotHash[kVideoSlots];
+	Common::Array<Binding> _bindings;
+	uint32 _useCounter;
+};
+
+} // End of namespace Neverhood
+
+#endif /* NEVERHOOD_HDLAYER_H */
