+// Claybox HD
+
+void Screen::hdSetOwner(int16 x, int16 y, int16 width, byte id, int16 srcX, int16 srcY) {
+	if (!_hdOwner || y < 0 || y >= 480)
+		return;
+	byte *owner = _hdOwner + y * 640;
+	int16 *src = _hdSource + (y * 640) * 2;
+	for (int16 xc = 0; xc < width; xc++) {
+		const int16 x1 = x + xc;
+		if (x1 < 0 || x1 >= 640)
+			continue;
+		owner[x1] = id;
+		_hdShadow[y * 640 + x1] = 0;
+		src[x1 * 2 + 0] = srcX + xc;
+		src[x1 * 2 + 1] = srcY;
+	}
+}
+
+void Screen::hdClearOwner(int16 x, int16 y, int16 width) {
+	if (!_hdOwner || y < 0 || y >= 480)
+		return;
+	const int16 x0 = MAX<int16>(x, 0);
+	const int16 x1 = MIN<int16>(x + width, 640);
+	if (x1 > x0) {
+		memset(_hdOwner + y * 640 + x0, 0, x1 - x0);
+		memset(_hdShadow + y * 640 + x0, 0, x1 - x0);
+	}
+}
+
+// Maps a channel value of the HD image, made with palette color `base`,
+// to where the game's current palette color `cur` has moved it (fades).
+static inline byte hdAdjust(byte v, byte base, byte cur) {
+	if (cur == base)
+		return v;
+	if (cur < base)
+		return (byte)((uint32)v * cur / base);
+	return (byte)(v + (uint32)(cur - base) * (255 - v) / (255 - base));
+}
+
+void Screen::hdCompose(const Common::Rect &r) {
+	const Graphics::PixelFormat &format = _hdScreen->format;
+	const int s = HDLayer::kScale;
+
+	uint32 lut[256];
+	byte rgb[256 * 3];
+	for (int i = 0; i < 256; i++) {
+		lut[i] = format.RGBToColor(_hdPalette[i * 4 + 0], _hdPalette[i * 4 + 1], _hdPalette[i * 4 + 2]);
+		rgb[i * 3 + 0] = _hdPalette[i * 4 + 0];
+		rgb[i * 3 + 1] = _hdPalette[i * 4 + 1];
+		rgb[i * 3 + 2] = _hdPalette[i * 4 + 2];
+	}
+
+	const HDImage *lastImage = nullptr;
+	bool sameColor[256];
+
+	for (int16 y = r.top; y < r.bottom; y++) {
+		const byte *back = (const byte*)_backScreen->getBasePtr(0, y);
+		const byte *owner = _hdOwner + y * 640;
+		const int16 *src = _hdSource + (y * 640) * 2;
+		uint32 *rows[HDLayer::kScale];
+		for (int j = 0; j < s; j++)
+			rows[j] = (uint32*)_hdScreen->getBasePtr(0, y * s + j);
+
+		for (int16 x = r.left; x < r.right; x++) {
+			const byte index = back[x];
+			const HDImage *image = owner[x] ? _hd->getImage(owner[x] & ~HDLayer::kDoubledFlag) : nullptr;
+			if (image && image->sprite) {
+				const int p = y * 640 + x;
+				const int sx = src[x * 2 + 0] * 2, sy = src[x * 2 + 1] * 2;
+				const Graphics::Surface &f = image->surface;
+				if (sx >= 0 && sy >= 0 && sx + 1 < f.w && sy + 1 < f.h && s == 2) {
+					const Graphics::PixelFormat sf = HDLayer::spriteFormat();
+					const bool spill = index == _hdUnderIndex[p];   // outside the original outline
+					const byte *base = image->basePalette + index * 4;
+					const byte *cur = _hdPalette + index * 4;
+					for (int j = 0; j < 2; j++)
+						for (int i = 0; i < 2; i++) {
+							byte a, cr, cg, cb;
+							sf.colorToARGB(*(const uint32*)f.getBasePtr(sx + i, sy + j), a, cr, cg, cb);
+							if (!spill) {
+								cr = hdAdjust(cr, base[0], cur[0]);
+								cg = hdAdjust(cg, base[1], cur[1]);
+								cb = hdAdjust(cb, base[2], cur[2]);
+							}
+							uint32 out;
+							if (a >= 250) {
+								out = format.RGBToColor(cr, cg, cb);
+							} else {
+								byte ur, ug, ub;
+								format.colorToRGB(hdSampleUnder(p, i, j, lut), ur, ug, ub);
+								out = format.RGBToColor((cr * a + ur * (255 - a)) / 255,
+									(cg * a + ug * (255 - a)) / 255, (cb * a + ub * (255 - a)) / 255);
+							}
+							rows[j][x * 2 + i] = out;
+						}
+					continue;
+				}
+				image = nullptr;
+			}
+			if (image && (owner[x] & HDLayer::kDoubledFlag)) {
+				// a 2x-doubled video: its HD frame has one pixel per screen pixel here,
+				// so smooth it up to the HD screen like the rest
+				const int sx = src[x * 2 + 0], sy = src[x * 2 + 1];
+				const Graphics::Surface &f = image->surface;
+				if (sx < 0 || sy < 0 || sx >= f.w || sy >= f.h) {
+					image = nullptr;
+				} else {
+					const int sxr = MIN<int>(sx + 1, f.w - 1), syd = MIN<int>(sy + 1, f.h - 1);
+					const uint32 c = *(const uint32*)f.getBasePtr(sx, sy);
+					const uint32 cr = *(const uint32*)f.getBasePtr(sxr, sy);
+					const uint32 cd = *(const uint32*)f.getBasePtr(sx, syd);
+					const uint32 crd = *(const uint32*)f.getBasePtr(sxr, syd);
+					byte r0, g0, b0, r1, g1, b1, r2, g2, b2, r3, g3, b3;
+					format.colorToRGB(c, r0, g0, b0);
+					format.colorToRGB(cr, r1, g1, b1);
+					format.colorToRGB(cd, r2, g2, b2);
+					format.colorToRGB(crd, r3, g3, b3);
+					rows[0][x * 2] = c;
+					rows[0][x * 2 + 1] = format.RGBToColor((r0 + r1) >> 1, (g0 + g1) >> 1, (b0 + b1) >> 1);
+					rows[1][x * 2] = format.RGBToColor((r0 + r2) >> 1, (g0 + g2) >> 1, (b0 + b2) >> 1);
+					rows[1][x * 2 + 1] = format.RGBToColor((r0 + r1 + r2 + r3) >> 2, (g0 + g1 + g2 + g3) >> 2, (b0 + b1 + b2 + b3) >> 2);
+					continue;
+				}
+			}
+			if (image) {
+				const int16 sx = src[x * 2 + 0] * s;
+				const int16 sy = src[x * 2 + 1] * s;
+				if (sx < 0 || sy < 0 || sx + s > image->surface.w || sy + s > image->surface.h)
+					image = nullptr;
+				else {
+					if (_hdShadow[y * 640 + x]) {
+						// a shadow: the HD background (in its own colors), darkened like the original
+						const byte orig = _hdUnderIndex[y * 640 + x];
+						const byte *co = rgb + orig * 3, *cs = rgb + index * 3;
+						for (int j = 0; j < s; j++)
+							for (int i = 0; i < s; i++) {
+								byte cr, cg, cb;
+								format.colorToRGB(hdSampleImage(image, sx + i, sy + j, orig), cr, cg, cb);
+								rows[j][x * s + i] = format.RGBToColor(co[0] ? MIN<int>(255, cr * cs[0] / co[0]) : cs[0],
+									co[1] ? MIN<int>(255, cg * cs[1] / co[1]) : cs[1], co[2] ? MIN<int>(255, cb * cs[2] / co[2]) : cs[2]);
+							}
+						continue;
+					}
+					if (image != lastImage) {
+						lastImage = image;
+						for (int i = 0; i < 256; i++)
+							sameColor[i] = image->video || memcmp(image->basePalette + i * 4, _hdPalette + i * 4, 3) == 0;
+					}
+					const byte *base = image->basePalette + index * 4;
+					const byte *cur = _hdPalette + index * 4;
+					for (int j = 0; j < s; j++) {
+						const uint32 *in = (const uint32*)image->surface.getBasePtr(sx, sy + j);
+						uint32 *out = rows[j] + x * s;
+						if (sameColor[index]) {
+							for (int i = 0; i < s; i++)
+								out[i] = in[i];
+						} else {
+							for (int i = 0; i < s; i++) {
+								byte cr, cg, cb;
+								format.colorToRGB(in[i], cr, cg, cb);
+								out[i] = format.RGBToColor(hdAdjust(cr, base[0], cur[0]),
+									hdAdjust(cg, base[1], cur[1]), hdAdjust(cb, base[2], cur[2]));
+							}
+						}
+					}
+				}
+			}
+			if (!image) {
+				if (_hdSmooth && s == 2) {
+					// Smooth 2x for everything without an HD image (videos, characters):
+					// each output pixel blends toward its right/lower neighbours.
+					const int xr = MIN<int>(x + 1, 639);
+					const byte *backDown = (const byte*)_backScreen->getBasePtr(0, MIN<int>(y + 1, 479));
+					const byte *c = rgb + index * 3;
+					const byte *cr = rgb + back[xr] * 3;
+					const byte *cd = rgb + backDown[x] * 3;
+					const byte *crd = rgb + backDown[xr] * 3;
+					rows[0][x * 2] = lut[index];
+					rows[0][x * 2 + 1] = format.RGBToColor((c[0] + cr[0]) >> 1, (c[1] + cr[1]) >> 1, (c[2] + cr[2]) >> 1);
+					rows[1][x * 2] = format.RGBToColor((c[0] + cd[0]) >> 1, (c[1] + cd[1]) >> 1, (c[2] + cd[2]) >> 1);
+					rows[1][x * 2 + 1] = format.RGBToColor((c[0] + cr[0] + cd[0] + crd[0]) >> 2,
+						(c[1] + cr[1] + cd[1] + crd[1]) >> 2, (c[2] + cr[2] + cd[2] + crd[2]) >> 2);
+				} else {
+					const uint32 color = lut[index];
+					for (int j = 0; j < s; j++)
+						for (int i = 0; i < s; i++)
+							rows[j][x * s + i] = color;
+				}
+			}
+		}
+	}
+}
+
+uint32 Screen::hdSampleImage(const HDImage *image, int x, int y, byte index) {
+	const Graphics::PixelFormat &format = _hdScreen->format;
+	const uint32 c = *(const uint32*)image->surface.getBasePtr(x, y);
+	if (image->video)
+		return c;
+	const byte *base = image->basePalette + index * 4;
+	const byte *cur = _hdPalette + index * 4;
+	if (base[0] == cur[0] && base[1] == cur[1] && base[2] == cur[2])
+		return c;
+	byte cr, cg, cb;
+	format.colorToRGB(c, cr, cg, cb);
+	return format.RGBToColor(hdAdjust(cr, base[0], cur[0]), hdAdjust(cg, base[1], cur[1]), hdAdjust(cb, base[2], cur[2]));
+}
+
+// The color under an HD sprite's sub-pixel (i, j) of logical pixel p.
+uint32 Screen::hdSampleUnder(int p, int i, int j, const uint32 *lut) {
+	const byte uid = _hdUnderOwner[p];
+	const byte uindex = _hdUnderIndex[p];
+	const HDImage *u = (uid && !(uid & HDLayer::kDoubledFlag)) ? _hd->getImage(uid) : nullptr;
+	if (u && !u->sprite) {
+		const int ux = _hdUnderSource[p * 2] * 2 + i, uy = _hdUnderSource[p * 2 + 1] * 2 + j;
+		if (ux >= 0 && uy >= 0 && ux < u->surface.w && uy < u->surface.h)
+			return hdSampleImage(u, ux, uy, uindex);
+	}
+	return lut[uindex];
+}
+
+void Screen::hdPresent(const Common::Rect &r) {
+	Common::Rect rect(r);
+	// smoothing reads the right/lower neighbours, so pixels just left/above a change change too
+	if (_hdSmooth) {
+		rect.left -= 1;
+		rect.top -= 1;
+	}
+	rect.clip(Common::Rect(0, 0, 640, 480));
+	if (rect.isEmpty())
+		return;
+	hdCompose(rect);
+	const int s = HDLayer::kScale;
+	_vm->_system->copyRectToScreen(_hdScreen->getBasePtr(rect.left * s, rect.top * s), _hdScreen->pitch,
+		rect.left * s, rect.top * s, rect.width() * s, rect.height() * s);
+}
+
 } // End of namespace Neverhood
