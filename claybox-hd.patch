+				const int y0 = (int)floorf(fy);
+				const float ty = fy - y0;
+				for (int x = 0; x < hdCursor.w; x++) {
+					const float fx = (x + 0.5f) / s - 0.5f;
+					const int x0 = (int)floorf(fx);
+					const float tx = fx - x0;
+					float a = 0, r = 0, g = 0, b = 0;
+					for (int k = 0; k < 4; k++) {
+						const int dx = k & 1, dy = k >> 1;
+						const float w = (dx ? tx : 1 - tx) * (dy ? ty : 1 - ty);
+						float cr = 0, cg = 0, cb = 0;
+						const float ca = px(x0 + dx, y0 + dy, cr, cg, cb) * w;
+						a += ca; r += cr * ca; g += cg * ca; b += cb * ca;
+					}
+					uint32 color = 0;
+					if (a > 0.001f) {
+						r /= a; g /= a; b /= a;
+						// keep edges crisp but smooth: steepen the alpha ramp
+						float alpha = CLIP((a - 0.5f) * 1.8f + 0.5f, 0.0f, 1.0f);
+						color = format.ARGBToColor((byte)(alpha * 255), (byte)r, (byte)g, (byte)b);
+					}
+					*(uint32*)hdCursor.getBasePtr(x, y) = color;
+				}
+			}
+			CursorMan.replaceCursor(hdCursor, -_drawOffset.x * s, -_drawOffset.y * s, 0);
+			hdCursor.free();
+		} else {
+			CursorMan.replaceCursor(*cursorSurface, -_drawOffset.x, -_drawOffset.y, 0);
+		}
 	}
 
 }
